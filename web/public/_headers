# En-têtes HTTP Cloudflare Pages (format _headers). Raisons et procédure :
# docs/SECURITY_LEGAL.md. ATTENTION : ce fichier NE s'applique PAS aux réponses
# des Pages Functions (functions/**) : elles posent leurs propres en-têtes.
# Si plusieurs règles matchent, Cloudflare CONCATÈNE les valeurs d'un même
# en-tête → ne jamais poser le même en-tête dans /* et dans une règle plus fine.
#
# CSP : le site est du HTML statique + UN script externe versionné (/s/site.<hash>.js) ;
# le runtime React/Next est retiré au postbuild (scripts/postbuild.mjs), qui ÉCHOUE si un
# <script> inline exécutable subsiste. → script-src 'self', sans 'unsafe-inline'. Le
# marqueur __CSP__ est remplacé au postbuild (Cloudflare Web Analytics ajouté seulement si
# NEXT_PUBLIC_CF_BEACON_TOKEN est défini). style-src 'self' : le postbuild échoue sur tout
# attribut style= ou <style> ; 'unsafe-inline' n'est ajouté que si la publicité est activée.
#
# Pour activer AdSense (seulement après la CMP TCF, voir components/Consent.tsx), ajouter
# à script-src/connect-src/frame-src/img-src les hôtes Google (pagead2.googlesyndication.com,
# *.googlesyndication.com, *.doubleclick.net, fundingchoicesmessages.google.com, *.google.com,
# *.gstatic.com, *.adtrafficquality.google) dans scripts/postbuild.mjs — et vérifier la console.
#
# HSTS : 6 mois, sans « preload ». N'ajouter « ; preload » (puis soumettre sur
# hstspreload.org) QUE sur le domaine définitif, quand tous ses sous-domaines
# sont en HTTPS : sortir de la liste preload prend des mois.
#

/*
  Content-Security-Policy: __CSP__
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), serial=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  ! Access-Control-Allow-Origin

# Pages HTML. Une règle par famille de chemins, SANS chevauchement (sinon Cloudflare
# concatène les Cache-Control) :
#  - ville et catégories : navigateur revalide toujours, CDN 5 min max (round 4, item 1) ;
#  - pages deal : revalidation à chaque visite, AUCUN cache CDN (round 4, item 1 : des pages
#    retirées étaient encore servies en HIT après 1 h 40) ; jamais un prix expiré ;
#  - pages légales : défaut Cloudflare (max-age=0, must-revalidate).
# og.png (sous /<l>/<ville>/) suit la règle de la ville : un seul max-age.
/de/st-gallen
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/fr/st-gallen
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/en/st-gallen
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/de/st-gallen/*
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/fr/st-gallen/*
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/en/st-gallen/*
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/de/deal/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/fr/deal/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
/en/deal/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
# Registre des slugs (relu par le build suivant) : jamais servi depuis un cache.
/slug-registry.json
  Cache-Control: no-store

# Ressources versionnées par hash : cache 1 an.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/s/*
  Cache-Control: public, max-age=31536000, immutable

# Icônes, manifeste : régénérés au build, cache court.
/icon.svg
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400
/de/manifest.webmanifest
  Cache-Control: public, max-age=86400
/fr/manifest.webmanifest
  Cache-Control: public, max-age=86400
/en/manifest.webmanifest
  Cache-Control: public, max-age=86400
/.well-known/security.txt
  Cache-Control: public, max-age=86400

# Les URLs *.pages.dev (production et previews) ne doivent jamais être indexées
# (contenu dupliqué avec le domaine définitif).
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
