# Local : .env.local. CI : GitHub → Settings → Secrets and variables → Actions → Variables
# (noms sans préfixe, voir .github/workflows/web.yml).
# Aucun de ces identifiants n'est un secret : ils apparaissent dans les liens publics.

# Flux de données produit par le scanner (GitHub Pages). Défaut : flux St. Gallen.
DATA_URL_CH_SG=https://yorian-melki.github.io/denner-deal-radar/data/universal.json
# URL publique canonique du site (sitemap, liens canoniques).
NEXT_PUBLIC_SITE_URL=https://savradar.com
# 1 = indexable par Google (seulement sur le domaine définitif).
SITE_INDEXABLE=
# Cloudflare Web Analytics (sans cookie) : jeton du site.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Affiliation — laisser vide = lien d'origine, jamais de lien affilié inventé.
AFF_TRADEDOUBLER_ID=            # ton identifiant de site Tradedoubler (a=)
AFF_TRADEDOUBLER_GALAXUS_P=     # id de programme Galaxus (p=), après acceptation
AFF_TRADEDOUBLER_DIGITEC_P=     # id de programme Digitec (p=), s'il existe
AFF_AWIN_ID=                    # ton identifiant éditeur Awin (awinaffid=)
AFF_AWIN_MIDS=                  # ex. "brack.ch=12345,revendo.ch=67890" (mid par marchand accepté)
AFF_AMAZON_DE_TAG=              # ex. monsite-21
AFF_ALIEXPRESS_TEMPLATE=        # lien profond du portail, avec {url} à la place de l'URL encodée
AFF_BOOKING_AID=                # aid Booking (via CJ/Awin selon le contrat)

# Publicité (après acceptation AdSense, et seulement avec consentement).
NEXT_PUBLIC_ADSENSE_CLIENT=     # ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT=

# Mentions légales (obligatoires en Suisse pour un site commercial, art. 3 al. 1 let. s LCD).
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_EMAIL=
